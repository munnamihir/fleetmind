POSTGRES_DB=fleetmind
POSTGRES_USER=fleetmind
POSTGRES_PASSWORD=fleetmind
DATABASE_URL=postgresql+psycopg://fleetmind:fleetmind@postgres:5432/fleetmind
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
TELEMETRY_TOPIC=vehicle.telemetry.v1
FAILURE_TOPIC=vehicle.failure-events.v1
SIMULATED_VEHICLES=500
SIM_EVENTS_PER_SECOND=120
SIM_TIME_ACCELERATION=600
VITE_API_URL=http://localhost:8000
ML_FAILURE_HORIZON_MILES=2500
ML_WINDOW_SIZE=12
ML_WINDOW_STRIDE=4
ML_MAX_EXAMPLES_PER_VEHICLE=32
ML_MAX_TELEMETRY_ROWS=250000
ML_MIN_TRAIN_EXAMPLES=500
ML_MIN_TRAIN_POSITIVES=5
ML_MIN_TEST_EXAMPLES=80
ML_STARTUP_DELAY_SECONDS=20
ML_TRAIN_INTERVAL_SECONDS=90
